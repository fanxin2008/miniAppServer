# 服务端口
PORT=8080

# 微信小程序凭证（在 mp.weixin.qq.com 后台获取）
WECHAT_APPID=your_appid
WECHAT_SECRET=your_secret

# JWT 签名密钥（请替换为随机长字符串）
JWT_SECRET=please_change_me_to_a_long_random_string

# 腾讯云 MySQL
DB_HOST=10.11.108.217
DB_PORT=3306
DB_USER=fanxin
DB_PASSWORD=your_password
DB_NAME=shache
DB_CONNECTION_LIMIT=10

# 每个用户每天的初始游戏次数
DAILY_PLAY_LIMIT=10

# 每日重置时区
TIMEZONE=Asia/Shanghai
