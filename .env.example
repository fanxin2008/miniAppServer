# 服务端口与监听地址
PORT=8080
HOST=0.0.0.0

# 微信小程序凭证（在 mp.weixin.qq.com 后台获取）
WECHAT_APPID=your_appid
WECHAT_SECRET=your_secret

# JWT 签名密钥与有效期
JWT_SECRET=please_change_me_to_a_long_random_string
JWT_EXPIRES_IN_SECONDS=7200

# 腾讯云 MySQL（连接时区按 UTC 处理 DATETIME(3)）
DB_HOST=10.11.108.217
DB_PORT=3306
DB_USER=fanxin
DB_PASSWORD=your_password
DB_NAME=shache
DB_CONNECTION_LIMIT=10

# 每个用户每天的初始挑战次数
DAILY_CHALLENGE_LIMIT=10

# 挑战会话有效期（秒）
CHALLENGE_SESSION_TTL_SECONDS=180

# IP 属地离线库（ip2region，可选；留空使用 npm 包内置的 ip2region.db / ipv6wry.db）
IP2REGION_IPV4_DB=
IP2REGION_IPV6_DB=
IP2REGION_DISABLE_IPV6=false

# 配额重置时区（固定为北京时间日历日）
TIMEZONE=Asia/Shanghai
